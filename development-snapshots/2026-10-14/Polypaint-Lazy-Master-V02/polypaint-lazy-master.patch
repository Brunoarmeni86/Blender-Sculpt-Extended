+    else if (!polypaint_resample(mmd, mmd.totlvl)) {
       return nullptr;
     }
     if (polypaint_grid(mmd, corner)) {
@@ -1358,7 +1463,8 @@ bool resample_all(MultiresModifierData &mmd, const int new_level, const int grid
