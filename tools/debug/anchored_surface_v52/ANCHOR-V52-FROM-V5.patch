+    frame.uv=frame.uv+uv_delta; distance+=length;
+    previous=p; previous_normal=n; previous_axis=next_axis;
+  }
+  frame.tangent_x=previous_axis;
+  return std::isfinite(distance) && std::isfinite(frame.uv.x) && std::isfinite(frame.uv.y);
 }
 
