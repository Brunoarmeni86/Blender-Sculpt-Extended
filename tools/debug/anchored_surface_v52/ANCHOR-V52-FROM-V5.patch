+static bool anchor_v52_seed_frame(const SubdivCCG &ccg, const CCGKey &key,
+                                  const AnchorV52Source &source,
+                                  const SubdivCCGCoord &control, const float3 &axis,
+                                  const float handedness, AnchorSurfacePathFrame &frame,
+                                  float &distance)
